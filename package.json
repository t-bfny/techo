{
  "name": "techo",
  "version": "0.19.0",
  "description": "A notebook that runs in your browser: offline, no account, notes stay on your device.",
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/third-party-licenses.mjs && vite build",
    "preview": "vite preview --host",
    "deploy": "npm run build && wrangler deploy",
    "test": "npm run build && playwright test",
    "test:quick": "npm run build && playwright test --grep-invert \"bigger than\""
  },
  "keywords": [],
  "author": "Yekipo",
  "license": "MIT",
  "repository": "github:t-bfny/techo",
  "homepage": "https://techo.t-bfny.workers.dev",
  "type": "module",
  "dependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-youtube": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "dompurify": "^3.4.16",
    "spark-md5": "^3.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.144.0"
  },
  "private": true
}
